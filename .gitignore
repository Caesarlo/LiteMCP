# Obsidian personal state and caches
.obsidian/workspace*.json
.obsidian/cache/
.obsidian/plugins/*/main.js
.obsidian/plugins/*/manifest.json
.obsidian/plugins/*/styles.css

# OS metadata
.DS_Store
Thumbs.db

# CodeGraph local index (regenerated per machine via `codegraph init`)
.codegraph/

# Local environment overrides (ports, etc.) — never committed.
# .env.example is the committed template.
.env

# Editor settings (machine/user specific)
.vscode/
