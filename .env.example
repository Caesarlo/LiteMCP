# LiteMCP backend configuration example.
#
# Copy this file to backend/.env (or export the variables in your
# environment) and edit the values. The backend loads configuration from
# the environment with the LITEMCP_ prefix — see
# backend/src/litemcp/core/config.py for the full contract.
#
# IMPORTANT: every value here is a PLACEHOLDER. Never commit real
# credentials as examples. `make validate-env-example` enforces that this
# file keeps its coverage and stays free of real secrets.

# --- application ---
LITEMCP_APP_NAME=litemcp
# one of: dev | test | prod
LITEMCP_ENVIRONMENT=dev
LITEMCP_DEBUG=false
# one of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LITEMCP_LOG_LEVEL=INFO

# --- database (required, startup fails fast if missing) ---
# SQLAlchemy async URL. PostgreSQL example; MySQL/mariadb variants are
# supported in later milestones.
LITEMCP_DATABASE_URL=postgresql+asyncpg://litemcp:litemcp_dev_password@localhost:5432/litemcp

# --- Redis (required, startup fails fast if missing) ---
LITEMCP_REDIS_URL=redis://localhost:6379/0

# --- encryption keys (required, startup fails fast if missing) ---
# One or more Fernet keys, comma separated. The first key is active, the
# rest are rotation history (see M1-SEC-001). Generate a real key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# The value below is a placeholder, not a usable key. A prod environment
# refuses sample/short keys at startup.
LITEMCP_ENCRYPTION_KEYS=change-me-generate-a-fernets-key

# --- gateway ---
# MCP data-plane gateway. Off by default (safe/closed).
LITEMCP_GATEWAY_ENABLED=false

# --- HTTP security ---
# Comma-separated explicit origins. prod refuses "*" and blank entries.
LITEMCP_ALLOWED_ORIGINS=http://localhost:5173
# Comma-separated trusted proxies, if the app sits behind a reverse proxy.
# LITEMCP_TRUSTED_PROXIES=127.0.0.1

# --- storage ---
LITEMCP_STORAGE_BACKEND=local
LITEMCP_STORAGE_PATH=./data/storage
